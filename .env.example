# 复制为 .env 后修改。.env 已在 .gitignore 中，禁止提交。
# 仅这些是“启动引导”变量，业务参数（上游密钥、New API 账号、检测间隔等）一律在页面「管理设置」录入。

# 数据库口令（自行生成强口令）
CW_DB_ROOT_PASSWORD=change-me-root
CW_DB_PASSWORD=change-me-db

# 加密/签名主密钥：至少 16 位随机串。用于加密落库的上游密钥与 New API 密码、签发登录令牌。
# 生成：openssl rand -hex 32     ⚠ 更换后已保存的密钥将无法解密，需要在页面重新录入。
CW_SECRET_KEY=

# 首次初始化管理员(admin)的口令。留空则自动生成随机口令并打印到后端日志（docker logs cloudwatch-backend）。
CW_ADMIN_PASSWORD=
